# Copy to .env.local (git-ignored) and fill in. Never prefix these with VITE_ —
# that would bundle the token into the public site.

# Webflow Data API v2 token (Site settings → Apps & integrations → API access).
# Scopes needed: sites:read, cms:read
WEBFLOW_API_TOKEN=

# Site ID (Site settings → General → Overview). Needed only if the token lacks sites:read.
WEBFLOW_SITE_ID=
